<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="container">
      <h1>Welcome to the Math Club</h1>
      <p style="text-align: center; margin-bottom: 2rem">
        A place for serious mathematical discussion. Sign in or register to join
        the conversation.
      </p>

      <div style="display: flex; gap: 1rem; justify-content: center">
        <a href="/signin"><button type="button">Sign In</button></a>
        <a href="/register"
          ><button
            type="button"
            style="background-color: var(--secondary-color)"
          >
            Register
          </button></a
        >
      </div>
    </div>
  </body>
</html>
